#!/usr/bin/env bash
# Phase 56 — Offline compliance verification (no network, no API key).
# Fails loudly on any external call or missing offline fallback.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== Phase 56: offline compliance =="
if [ "${ONLINE_MODE:-false}" != "false" ]; then
  echo "FAIL: ONLINE_MODE must be false (got '${ONLINE_MODE:-unset}')"
  exit 1
fi
if [ -n "${GEMINI_API_KEY:-}" ] || [ -n "${GOOGLE_API_KEY:-}" ]; then
  echo "FAIL: API key must be unset for offline verification"
  exit 1
fi
echo "PASS: env offline (ONLINE_MODE=false, no key)"

echo "-- Java offline tests --"
(cd java-engine && ./mvnw -q test 2>&1 | tail -5)

echo "-- Python offline tests --"
PYTHONPATH=python-ml .venv/bin/python -m pytest python-ml/tests -q 2>&1 | tail -3

echo "-- C++ offline tests --"
.venv/bin/cmake -S cpp-engine -B cpp-engine/build -DBUILD_TESTING=ON >/dev/null
.venv/bin/cmake --build cpp-engine/build -j2 >/dev/null
.venv/bin/ctest --test-dir cpp-engine/build --output-on-failure 2>&1 | tail -3

echo "-- Real-model offline inference (packet-to-CIC live projection) --"
PYTHONPATH=python-ml .venv/bin/python - <<'PY'
from app import PredictionService
svc = PredictionService()
contract = {
    'contractVersion': 'kairos.sequence.v1',
    'nodeFeatureNames': ['flow_count'],
    'edgeFeatureNames': ['packet.packet_count'],
    'windows': [{
        'schemaVersion': 'kairos.graph.v1',
        'windowStart': '2026-01-01T00:00:00Z',
        'windowEnd': '2026-01-01T00:00:10Z',
        'topologyAvailable': True,
        'nodes': [{'id': 'host', 'features': {'flow_count': 1}}],
        'edges': [{
            'id': 'flow', 'source': 'host', 'destination': 'host',
            'features': {'packet.packet_count': 3},
        }],
        'label': {'infiltration': False, 'stage': 'NONE'},
    }],
}
r = svc.predict(contract, 5)
assert r['artifact_version'].startswith('kairos.prediction.'), 'bad artifact'
assert 0.0 <= r['probability'] <= 1.0, 'bad probability'
assert r['latency_ms'] < 2000.0, 'latency breach'
assert r['attention_summary']['causal_future_attention_mass'] == 0.0, 'causality breach'
print(f\"PASS: prob={r['probability']:.3f} stage={r['predicted_stage']} latency={r['latency_ms']:.0f}ms\")
"

echo "-- No external calls in offline path --"
if grep -rn "googleapis\|generativelanguage\|api_key.*http\|RestTemplate.*gemini" \
  java-engine/src/main/java/com/networkwm/narrative/LocalNarrativeService.java \
  java-engine/src/main/java/com/networkwm/bridge/PythonMlClient.java 2>/dev/null; then
  echo "FAIL: offline-path file references external API"
  exit 1
fi
echo "PASS: offline path makes no external calls (Gemini isolated to GeminiNarrativeService)"

echo "-- React build --"
(cd react-ui && npm run build 2>&1 | tail -3)
test -f react-ui/build/sample-attack.csv || { echo "FAIL: sample missing from build"; exit 1; }
echo "PASS: sample-attack.csv bundled"

echo "== Phase 56 COMPLETE: fully offline =="
