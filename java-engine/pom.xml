<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>com.networkwm</groupId>
    <artifactId>java-engine</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>java-engine</name>
    <description>Base orchestration engine for the Network Attack World Model.</description>

    <properties>
        <java.version>17</java.version>
        <google-genai.version>1.20.0</google-genai.version>
        <okhttp.version>4.12.0</okhttp.version>
        <!-- Native bridge library for the Phase 7 JNI round-trip test.
             Overridable: mvn test -Dkairos.native.library=/custom/path.so -->
        <kairos.native.library>${project.basedir}/../cpp-engine/build/libkairos_native.so</kairos.native.library>
    </properties>

    <dependencies>
        <!-- REST API server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Gemini Java SDK for narrative generation -->
        <dependency>
            <groupId>com.google.genai</groupId>
            <artifactId>google-genai</artifactId>
            <version>${google-genai.version}</version>
        </dependency>

        <!-- JSON handling -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- REST client to python-ml service -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Always pass the native library so CppBridgeIntegrationTest
                         executes and can fail loudly instead of silently
                         skipping when the property is unset (Fix 6). -->
                    <systemPropertyVariables>
                        <kairos.native.library>${kairos.native.library}</kairos.native.library>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
