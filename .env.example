# The complete demo must work with this disabled and without a Gemini key.
ONLINE_MODE=false

# Optional: used only when ONLINE_MODE=true for enhanced SOC narratives.
# Primary key name; GOOGLE_API_KEY is accepted as a legacy fallback.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest

# Optional: override the Python ML service URL (default: http://127.0.0.1:5000).
# KAIROS_ML_URL=http://127.0.0.1:5000
