# The complete demo must work with this disabled and without a Gemini key.
ONLINE_MODE=false

# Optional: used only when ONLINE_MODE=true for enhanced SOC narratives.
# Primary key name; GOOGLE_API_KEY is accepted as a legacy fallback.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest

# Optional: override the Python ML service URL (default: http://127.0.0.1:5000).
# KAIROS_ML_URL=http://127.0.0.1:5000

# Passive live capture is denied by default. Explicitly allow only interfaces
# and address ranges that you own or are authorized to monitor.
# KAIROS_LIVE_ALLOWED_INTERFACES=lo
# KAIROS_LIVE_ALLOWED_CIDRS=127.0.0.0/8,::1/128

# Optional native live-stream helper path. The default is discovered from
# cpp-engine/build or cpp-engine/cmake-build-local.
# KAIROS_LIVE_HELPER=/absolute/path/to/kairos_live_stream
